# Yahoo Mail MCP Server Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# =============================================================================
# REQUIRED: Yahoo Mail Credentials
# =============================================================================

# Your Yahoo Mail email address
YAHOO_EMAIL=your.email@yahoo.com

# Yahoo Mail app-specific password (16 characters)
# Generate at: https://login.yahoo.com/account/security/app-passwords
# Instructions:
#   1. Go to https://login.yahoo.com/account/security
#   2. Click "Generate app password" or "Manage app passwords"
#   3. Select "Other App" and enter "MCP Server"
#   4. Copy the generated 16-character password
YAHOO_APP_PASSWORD=your16charpassword

# =============================================================================
# TRANSPORT MODE (for local development)
# =============================================================================

# Choose transport mode:
#   - stdio: For local desktop use with Claude Desktop
#   - sse: For HTTP/SSE mode (required for Render.com deployment)
TRANSPORT_MODE=stdio

# Port for SSE mode (only used when TRANSPORT_MODE=sse)
PORT=3000

# =============================================================================
# OPTIONAL: OAuth2 Credentials
# =============================================================================

# If you want to use OAuth2 instead of app passwords (advanced)
# YAHOO_CLIENT_ID=your_client_id
# YAHOO_CLIENT_SECRET=your_client_secret

# =============================================================================
# SECURITY (REQUIRED for production!)
# =============================================================================

# OAuth 2.0 Client Credentials - REQUIRED to secure your MCP server!
# Generate strong random credentials:
#   Client ID: openssl rand -hex 16
#   Client Secret: openssl rand -hex 32
# Configure these in Claude Desktop > Settings > Connectors > Advanced Settings
OAUTH_CLIENT_ID=your-client-id-here
OAUTH_CLIENT_SECRET=your-client-secret-here

# Owner approval password - STRONGLY RECOMMENDED for remote deployments.
# The client_id is not secret, so without this /oauth/authorize approves every request
# automatically. When set, /oauth/authorize shows a consent page and only issues an
# authorization code after this password is entered. Generate one with: openssl rand -base64 24
# OAUTH_APPROVAL_PASSWORD=your-approval-password

# Trust the reverse proxy's X-Forwarded-For header so rate limiting sees real client IPs.
# Set TRUST_PROXY=1 on Render.com (or behind any single proxy hop). Leave unset when clients
# connect directly, otherwise they can spoof their IP.
# TRUST_PROXY=1

# In-memory per-IP rate limits (requests per window, default window 60000 ms; 0 disables).
# RATE_LIMIT_OAUTH_PER_MIN applies separately to GET/POST /oauth/authorize and POST /oauth/token.
# RATE_LIMIT_OAUTH_PER_MIN=10
# RATE_LIMIT_MCP_PER_MIN=120
# RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# PRODUCTION SETTINGS (for Render.com)
# =============================================================================

# When deploying to Render.com, set these in the Render Dashboard:
#   - YAHOO_EMAIL
#   - YAHOO_APP_PASSWORD
#   - TRANSPORT_MODE=sse
#   - OAUTH_CLIENT_ID (generate with: openssl rand -hex 16)
#   - OAUTH_CLIENT_SECRET (generate with: openssl rand -hex 32)
#   - OAUTH_APPROVAL_PASSWORD (recommended; generate with: openssl rand -base64 24)
#   - TRUST_PROXY=1 (Render sits behind a proxy)
#   - PORT (automatically set by Render)
#   - NODE_ENV=production (automatically set)